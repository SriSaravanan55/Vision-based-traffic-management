# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Persistent Python Traffic AI Service
PYTHON_API_HOST="127.0.0.1"
PYTHON_API_PORT="8000"
PYTHON_API_URL="http://127.0.0.1:8000"
AUTO_START_PYTHON="true"
# Optional: path to Python executable (defaults to .venv if present, then system python)
PYTHON_PATH=""
TRAFFIC_DB_PATH="data/traffic_history.db"

# MQTT Broker Configuration (Optional)
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT="1883"
